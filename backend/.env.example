# ==============================================================================
# FINServ Backend Environment Configuration (Template)
# Copy this file to `backend/.env` and update with your local credentials.
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Strict UTC Timezone, NO createDatabaseIfNotExist)
DB_URL=jdbc:mysql://localhost:3306/finserv_db?useSSL=false&serverTimezone=UTC&connectionTimeZone=UTC&allowPublicKeyRetrieval=true

# Migration User (DDL & Schema Versioning)
DB_MIGRATION_USERNAME=finserv_migration
DB_MIGRATION_PASSWORD=

# Application Runtime User (Restricted DML)
DB_USERNAME=finserv_app
DB_PASSWORD=

# Field-Level Encryption Master Key (AES-256-GCM 32-byte Hex)
APP_ENCRYPTION_KEY=

# Superadmin Initial Bootstrap Credentials (First-run runner only)
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@finserv.local

# Optional local demo personas; required only with both `dev` and `demo` profiles.
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_OFFICER_PASSWORD=

# JWT Authentication (set a unique random secret of at least 32 bytes)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Security
BCRYPT_STRENGTH=12
