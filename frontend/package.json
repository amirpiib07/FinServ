    "eslint-plugin-react-refresh": "^0.5.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
