    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.104.2",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
