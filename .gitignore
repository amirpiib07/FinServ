
# ==========================================
# FinServ Root .gitignore
# ==========================================

# Secrets and Environment Variables
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Local Spring Boot configuration
application-local.properties
application-local.yml
application-local.yaml

# Java / Maven / Gradle
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.gradle/
build/
bin/

# Node / Frontend
**/node_modules/
**/dist/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.vite/

# IDE and Editor Files
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs and Temporary Files
logs/
*.log
tmp/
temp/
scratch/

# Local database backups
*.bak
*.dump
*.sql.gz
